# Neoteric-OS labels the powercap sysfs nodes sysfs_powercap in its platform policy (board API
# 202604); the same access the vendor policy grants on vendor_sysfs_powercap
allow vendor_thermal-engine sysfs_powercap:dir r_dir_perms;
allow vendor_thermal-engine sysfs_powercap:file rw_file_perms;

allow vendor_qlm_service sysfs_powercap:dir r_dir_perms;
allow vendor_qlm_service sysfs_powercap:file r_file_perms;

allow hal_power_stats_default sysfs_powercap:dir r_dir_perms;
allow hal_power_stats_default sysfs_powercap:file rw_file_perms;

allow system_server sysfs_powercap:dir r_dir_perms;
allow system_server sysfs_powercap:file r_file_perms;
