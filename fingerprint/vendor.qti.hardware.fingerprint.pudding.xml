     Services the stock Qualcomm fingerprint HAL module registers in the fingerprint service
     process: the Qualcomm extension and a fallback fx.tunnel service (the module aborts if it
     cannot register it).
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>vendor.qti.hardware.fingerprint</name>
        <fqname>IQfpExtendedFingerprint/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.xiaomi.hardware.fx.tunnel</name>
        <fqname>IMiFxTunnel/default</fqname>
    </hal>
</manifest>
